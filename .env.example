GEMINI_API_KEY=put_your_key_here
GEMINI_EXTRACTOR_MODEL=put_model_name_here

SUPABASE_URL=put_supabase_url_here
SUPABASE_SECRET_KEY=put_supabase_secret_key_here

EXTRACTION_VERSION=QEE_v1
QUESTION_OBJECT_VERSION=QOS_v1

# Optional. How long to wait for one Gemini call before giving up.
GEMINI_TIMEOUT_SECONDS=300

# Optional. Leave at 0 to use the model's own default output limit. Raise it
# only if long papers come back as TruncatedResponseError.
GEMINI_MAX_OUTPUT_TOKENS=0

# Optional. Render a PNG for every question marked diagram_required.
RENDER_DIAGRAMS=true
DIAGRAM_DPI=200
